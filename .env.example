# Secrets and third-party toggles only. Copy to `.env` (git-ignored) for local runs.
#
# Policy (models, datasource kind, corpus path, serve flags) lives in
# governed_bi.toml, with optional overrides in governed_bi.local.toml.
# This file only supplies secret *values* (and framework tracing switches that
# LangChain/Langfuse read from the environment). A real shell environment
# variable always wins over `.env`.

# Named by [models].api_key_env in governed_bi.toml (default OPENAI_API_KEY).
OPENAI_API_KEY=sk-...

# Named by [datasource].dsn_env when kind is postgres/redshift. Example for the
# BIRD-Obfuscation renamed+decoy instance (local docker, port 5435):
# PG_RENAME_DECOY_DSN=host=127.0.0.1 port=5435 dbname=bird user=bird password=bird

# Named by [logging].conversation_checkpointer_dsn_env, and only read when
# conversation_checkpointer_kind = "postgres" (ADR 0004). The default checkpointer is
# SQLite on a local path, so most runs need nothing here.
# CHECKPOINT_DSN=host=127.0.0.1 port=5432 dbname=governed_bi user=... password=...

# ---------------------------------------------------------------------------
# Optional: AWS Bedrock ([models].provider = "bedrock"; `uv sync --extra bedrock`)
# ---------------------------------------------------------------------------
# boto3 resolves credentials from its own chain, so these are only one option —
# a shared profile (AWS_PROFILE) or an instance/task role works just as well and
# keeps long-lived keys off disk. [models].api_key_env only names the variable
# whose presence means "live"; it never holds the secret.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...        # only for temporary / STS credentials
# Region comes from this chain too ([models].region is left unset so it doesn't
# override an existing profile/env setting; set it there only to pin a different one).
# AWS_REGION=us-east-1

# Named by [serve].api_key_env when mutating HTTP routes should require a shared
# secret (X-API-Key or Authorization: Bearer). Unset = demo mode (reads open;
# writes still need allow_edit).
# GOVERNED_BI_API_KEY=change-me

# ---------------------------------------------------------------------------
# Optional: LangSmith (native LangChain/LangGraph tracing — no extra package)
# ---------------------------------------------------------------------------
# Either tracing toggle works; LANGSMITH_TRACING is the current LangSmith name,
# LANGCHAIN_TRACING_V2 is the legacy alias. Both need LANGSMITH_API_KEY.
# LANGSMITH_TRACING=true
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=governed-bi

# ---------------------------------------------------------------------------
# Optional: Langfuse (LangChain callback — installed by default; no extra needed)
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
