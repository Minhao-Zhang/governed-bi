# Copy this file to `.env` and fill in the values you need. `.env` is git-ignored.
#
# This file holds secrets and deployment pointers only. Behaviour lives in
# `register/knobs.py`; there is no TOML config path in `src/`. A real shell
# variable always beats `.env`.
#
# Full reference: docs/usage.md#environment

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The database. Serve and the eval driver both read GOVERNED_BI_PG_DSN first,
# then PG_RENAME_DECOY_DSN. The eval driver also accepts `--pg-dsn`, whose own
# default carries no password.
GOVERNED_BI_PG_DSN=host=127.0.0.1 port=5432 dbname=... user=... password=...

# Model access on the `openai` gateway, which is the default for all three
# surfaces. Bedrock takes whatever boto3 resolves and so has no key variable;
# the proxy gateway reads its key from Secrets Manager.
OPENAI_API_KEY=sk-...

# The semantic layer. Resolved against this repository's root, not the
# process's working directory.
GOVERNED_BI_CORPUS_DIR=../BIRD-corpus

# There is no transport credential. Removed 2026-08-13: no served route asks
# for one, so anything that can reach the port can drive the engine and read
# `/audit/turns`. Bind the server to loopback and treat the port as the
# boundary — docs/usage.md#serve-langgraph-server says what that re-exposes.

# A `StaticRoleAccessPolicy` TOML file (ADR 0012 §2). Unset means `OpenAccessPolicy`,
# which authorizes every table and is what this repository ships — so every
# authorization rule fires and every one of them says yes.
#
# Read by `api/graph_app.py::access_policy_from_environment` and resolved against the
# repository root, not the process's cwd, for the same reason GOVERNED_BI_CORPUS_DIR is:
# a relative path read from the wrong directory fails as "no such file" instead of
# "you are somewhere else". A path that does not exist is a startup RuntimeError, not a
# silent fallback to open.
#
# There is one principal here and nothing on the transport distinguishes callers, so a
# non-open policy narrows every caller identically. Per-caller grants need a second
# principal first — `docs/enterprise-fork.md` carries what that owes.
# GOVERNED_BI_ACCESS_POLICY=access-policy.toml

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Three surfaces take a model and each resolves its own provider: the agent that
# writes SQL, the utility model behind the scope gate and the facet rewriters,
# and the embedder. The ids do not fall back to one another — a cheap rewriter
# beside an expensive agent is the normal configuration.
#
# An embedding id is not portable across gateways: text-embedding-3-large on
# OpenAI, amazon.titan-embed-text-v2:0 on Bedrock.

# GOVERNED_BI_MODEL=
# GOVERNED_BI_MODEL_EFFORT=high
# GOVERNED_BI_UTILITY_MODEL=
# GOVERNED_BI_UTILITY_MODEL_EFFORT=
# GOVERNED_BI_EMBEDDING_MODEL=text-embedding-3-large

# Unset means `openai`. Set one variable for all three surfaces, or override a
# surface individually. Each value is a distinct arm and is recorded as
# llm_provider / llm_utility_provider / embedding_provider, because the same
# model id behind two gateways is two treatments that would otherwise share one
# config hash.
# GOVERNED_BI_PROVIDER=openai
# GOVERNED_BI_MODEL_PROVIDER=
# GOVERNED_BI_UTILITY_PROVIDER=
# GOVERNED_BI_EMBEDDING_PROVIDER=

# Bedrock only. Needs `uv sync --extra bedrock`. Credentials are whatever boto3
# resolves — static keys, AWS_PROFILE, or an instance or task role with nothing
# set here — so there is no key variable to list. Region is read in this order,
# the engine's own name first so it wins over whatever the shell exports for
# other tooling: GOVERNED_BI_AWS_REGION, AWS_REGION, AWS_DEFAULT_REGION.
# GOVERNED_BI_AWS_REGION=us-east-1

# Proxy gateway only. The first value is the *name* of a Secrets Manager secret
# holding the key and base URL, never the key itself.
# GOVERNED_BI_PROXY_SECRET=
# GOVERNED_BI_PROXY_REGION=
# GOVERNED_BI_PROXY_CA_BUNDLE=

# ---------------------------------------------------------------------------
# Timeouts and retries
# ---------------------------------------------------------------------------
# Each of these is a comparability knob. Keep them identical across arms you
# intend to compare, or the arms differ by more than the thing under test.
# GOVERNED_BI_LLM_MAX_RETRIES=3
# GOVERNED_BI_LLM_TIMEOUT_S=300
# GOVERNED_BI_UTILITY_TIMEOUT_S=30

# These three outrank `knobs_resolved`, which is filled from the register
# defaults alone. Setting one changes behaviour while the measurement row still
# publishes the default — see docs/open-work.md §3.8 before using them in an arm.
# GOVERNED_BI_AGENT_NODE_TIMEOUT_S=1200
# GOVERNED_BI_AGENT_RECURSION_LIMIT=40
# GOVERNED_BI_RAIL_NODE_TIMEOUT_S=120

# ---------------------------------------------------------------------------
# Do not set OPENAI_BASE_URL
# ---------------------------------------------------------------------------
# It redirects the chat client and the embedder together, because both build an
# OpenAI-shaped client and both read it. A gateway that serves a chat model but
# not an embedding model cannot be expressed this way. Use the per-surface
# provider variables above instead.

# ---------------------------------------------------------------------------
# Tracing — LangSmith, and only LangSmith
# ---------------------------------------------------------------------------
# Off by default. LangSmith bills one trace per root invocation, so a whole
# agentic turn costs one trace and a 20-question debug run costs 20. LangChain
# reads these variables itself; there is no callback to wire.
#
# When tracing is on, traces carry run inputs and outputs in full — tool
# messages, row previews, governed context. That is intended here: this
# repository is not production, and sensitive columns are filtered at the
# datasource before they can reach a tool message. A production deployment
# would need a masking layer at the tracer seam. There is none here.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=governed-bi
