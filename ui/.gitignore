# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is committed, the same way `../.env.example` is on the engine side. It holds no
# secret -- see its header for why the two files cannot be one.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Throwaway dev-server build dirs (NEXT_DIST_DIR), used to verify a UI change in a
# browser beside the primary dev server. Two `next dev` processes cannot share `.next`.
# `.next-mock` is the mock-mode entry's (`ui-mock-3200` in .claude/launch.json), which
# runs with NEXT_PUBLIC_LANGGRAPH_URL empty and needs no engine.
.next-verify
.next-mock
