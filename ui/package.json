{
  "name": "governed-bi-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Web frontend for the governed-bi engine in the same repository (../src/governed_bi): chat, semantic-layer schema/graph, corpus, and audit views. A pure HTTP client -- it shares no module with the engine.",
